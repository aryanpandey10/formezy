# Copy to `.env.local` for development or set in your host (Vercel, Docker, etc.).
# Never commit real secrets.

# --- EmailJS (lead forms — used first from the browser when all three are set) ---
# https://www.emailjs.com/ — create Email Service + Template; map template variables from lib/submit-lead.ts
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Optional: separate template for "Book a Demo" if you use a different one in EmailJS (must use same {{name}}, {{email}}, {{time}}, etc.)
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_BOOK_DEMO=

# --- SMTP (future /api/send-lead — commented out in route; see app/api/send-lead/route.ts) — Zoho example ---
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@safalinfosoft.com
# SMTP_PASS=your-zoho-app-password
# SMTP_FROM="Formezy <hello@safalinfosoft.com>"

# --- Gmail (alternative) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Formezy <your-sending@gmail.com>"

# Comma-separated recipients (optional; defaults to lib/lead-emails.ts)
# NOTIFICATION_EMAILS=cmo@safalinfosoft.com,dipak@safalinfosoft.com

# --- Resend (optional fallback if SMTP not set) ---
# RESEND_API_KEY=
# RESEND_FROM="Formezy <notify@your-verified-domain.com>"

# Public site URL (set in production so links, OG, and form API calls match your domain)
# NEXT_PUBLIC_APP_URL=https://formezy.com
# If the form is ever posted to a different origin than the page, set the API base (usually leave unset)
# NEXT_PUBLIC_API_BASE_URL=https://formezy.com

# --- Static export (cPanel): `npm run build:out` — upload entire `out/` including `.htaccess` ---
# No server API for forms; EmailJS keys above must be set before `npm run build:out`.
